# Copy to .env for local development. Never commit real credentials.
# Current RFQ intake uses fixed rules and does not call an AI provider.
# This optional key is reserved for the provider integration, not yet connected.
ANTHROPIC_API_KEY=

# Sponsor gateway, OpenAI-compatible. Provider adapter is coordinated with Yuval.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=anthropic/claude-opus-5

# Optional Jev routing diagnostics. Keep the real credential in ignored .env.
# On macOS, script/load-jev-key imports your existing jev-api-key Keychain entry.
JEV_API_KEY=

# Live distributor pricing: interpretation only, never price generation.
# Uses the same confirmed Nicrron gateway; keep the real key local.
NINOO_API_KEY=
NINOO_MODEL=anthropic/claude-opus-5
# Operator-controlled supplier/checkout adapter with current commercial evidence.
# Leave empty until a real procurement service is connected.
DISTRIBUTOR_PROCUREMENT_FEED=

# Development-only optional parser enrichment. Keep 0 until live smoke passes.
# Catalog-model calls stay disabled pending their source-evidence contract.
RFQ_LIVE_MODELS=0
