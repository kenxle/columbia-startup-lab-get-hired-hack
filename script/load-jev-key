#!/usr/bin/env python3
"""Copy this Mac's Jev Keychain entry into the ignored Rails environment file."""
import os
from pathlib import Path
import re
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
target = root / ".env"
if subprocess.run(["git", "check-ignore", "-q", ".env"], cwd=root).returncode:
    sys.exit("Refusing to save a key: .env must be gitignored.")

result = subprocess.run(
    ["/usr/bin/security", "find-generic-password", "-a", os.environ["USER"],
     "-s", "jev-api-key", "-w"], capture_output=True, text=True)
if result.returncode:
    sys.exit("No accessible jev-api-key entry on this Mac. Save the actual key locally first; a Keychain lookup command does not transfer it.")

key = result.stdout.rstrip("\r\n")
if not key or not re.fullmatch(r"[A-Za-z0-9._~+/:=-]+", key):
    sys.exit("The Keychain value is empty or unsupported. .env was not changed.")

previous = target.read_text() if target.exists() else ""
entry = "JEV_API_KEY=" + key
pattern = r"^(?:export\s+)?JEV_API_KEY=.*$"
if re.search(pattern, previous, re.M):
    updated = re.sub(pattern, lambda _: entry, previous, flags=re.M)
else:
    updated = previous.rstrip("\n") + "\n" + entry + "\n"
with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as file:
    file.write(updated)
target.chmod(0o600)
print("JEV_API_KEY saved to ignored .env. Restart Rails to load it. The value was not displayed.")
