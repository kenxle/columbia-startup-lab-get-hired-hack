<% content_for :title, "Final quote · #{@quote.reference}" %>

<header class="page-header">
  <div>
    <p class="eyebrow"><%= @quote.reference %> / Approved quote</p>
    <h1 class="page-title">Email and quote documents</h1>
    <p class="page-lede">The approved lines, with prices, lead times and requested paperwork.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Local email previews", quote_local_previews_path(@quote), class: "button button--quiet" if local_email_preview_available? %>
    <%= link_to "Back to quote", quote_path(@quote), class: "button button--quiet" %>
  </div>
</header>

<section class="panel final-quote" aria-labelledby="final-quote-heading">
  <div class="final-quote__status">
    <% if @quote.sent_locally? %>
      <span class="buyer-draft__badge">Sent (local preview)</span>
      <p>Saved <%= display_time(@quote.sent_at) %> for <%= @quote.sent_recipient %> (placeholder). No real email was sent.</p>
    <% else %>
      <span class="buyer-draft__badge">Draft, not sent</span>
      <p>Send to the local preview inbox, or download the documents.</p>
    <% end %>
  </div>
  <div class="final-quote__content">
    <h2 id="final-quote-heading" class="section-title">Email preview</h2>
    <dl class="buyer-draft__envelope">
      <dt>Subject</dt><dd><%= @draft.subject %></dd>
      <dt>Buyer</dt><dd><%= @quote.buyer_name.presence || "Not provided" %></dd>
    </dl>
    <pre class="final-quote__body"><%= @body %></pre>
    <div class="final-quote__documents" aria-label="Quote documents">
      <%= link_to "Download quote PDF", pdf_quote_final_quote_path(@quote), class: "button button--primary" %>
      <%= link_to "Download spreadsheet (.csv)", export_quote_path(@quote, format: :csv), class: "button button--quiet" %>
      <%= link_to "Download email draft (.txt)", download_quote_final_quote_path(@quote), class: "button button--quiet" %>
    </div>
    <% if local_email_preview_available? %>
      <div class="final-quote__delivery">
        <% unless @quote.sent_locally? %>
          <%= button_to "Send approved quote (local preview)", deliver_quote_final_quote_path(@quote),
                params: { reviewed_version: @quote.review_revision }, class: "button button--primary" %>
          <p class="field__hint">Saves the email with PDF and CSV attachments to the local inbox and marks this revision Sent. Recipient: buyer@example.invalid (placeholder). No real email is sent.</p>
        <% end %>
        <%= button_to "Open local email with attachments", preview_email_quote_final_quote_path(@quote),
              params: { reviewed_version: @quote.review_revision }, class: "button button--quiet" %>
        <p class="field__hint">Previewing alone does not mark the quote Sent.</p>
      </div>
    <% end %>
  </div>
</section>
