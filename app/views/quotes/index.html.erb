<% content_for :title, "Quotes" %>

<header class="page-header">
  <div>
    <p class="eyebrow">Workspace</p>
    <h1 class="page-title">Quotes</h1>
    <p class="page-lede">Review incoming RFQs, resolve questions, and prepare quotes for approval.</p>
  </div>
  <div class="page-actions">
    <%= button_to "Load RFQ example", demo_quotes_path, method: :post, class: "button button--quiet" %>
    <%= link_to "New RFQ", new_quote_path, class: "button button--primary" %>
  </div>
</header>

<% if @quotes.blank? %>
  <section class="empty-state" aria-labelledby="empty-title">
    <h2 id="empty-title" class="empty-state__title">No RFQs yet</h2>
    <p class="empty-state__body">Paste a buyer email or upload a file to start a quote. To see the review flow, load the RFQ example.</p>
    <div class="empty-state__actions">
      <%= link_to "New RFQ", new_quote_path, class: "button button--primary" %>
      <%= button_to "Load RFQ example", demo_quotes_path, method: :post, class: "button button--quiet" %>
    </div>
  </section>
<% else %>
  <section class="panel" aria-labelledby="quotes-heading">
    <h2 id="quotes-heading" class="visually-hidden">Saved RFQs</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Reference</th>
            <th scope="col">Title</th>
            <th scope="col">Buyer</th>
            <th scope="col" class="num">Ready</th>
            <th scope="col" class="num">Held</th>
            <th scope="col" class="num">Subtotal</th>
            <th scope="col">Status</th>
            <th scope="col">Due</th>
            <th scope="col">Received</th>
          </tr>
        </thead>
        <tbody>
          <% @quotes.each do |quote| %>
            <tr>
              <th scope="row" class="mono">
                <%= link_to quote.reference, quote_path(quote), class: "row-link" %>
              </th>
              <td>
                <%= display_value(quote.title) %>
              </td>
              <td><%= display_value(quote.buyer_name) %></td>
              <td class="num"><%= quote.ready_count %></td>
              <td class="num"><%= quote.held_count %></td>
              <td class="num mono"><%= quote.awaiting_processing? ? unknown_marker : display_money(quote.subtotal) %></td>
              <td><%= quote_status_badge(quote) %></td>
              <td><%= quote_deadline_badge(quote) %></td>
              <td class="muted"><%= display_time(quote.created_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
