<section class="review__source" aria-labelledby="source-heading">
  <div class="panel panel--source">
    <div class="panel__head">
      <h2 id="source-heading" class="panel__title">Original RFQ</h2>
      <% if quote.source_bytes.present? && quote.original_filename.present? %>
        <%= link_to source_quote_path(quote), class: "file-link" do %>
          Download <span class="mono"><%= quote.original_filename %></span>
        <% end %>
      <% end %>
    </div>

    <% if selected_line.present? %>
      <p class="panel__meta">Source words for line <%= selected_line.position %> are highlighted where found.</p>
    <% end %>
    <% document = @source_document || QuoteWorkspace::SourceDocument.new(quote).call %>
    <% document.sections.each do |section| %>
      <% if document.sections.many? %><h3 class="section-title"><%= section[:label] %></h3><% end %>
      <pre class="source-text" tabindex="0" aria-label="<%= section[:label] %>"><%= highlighted_source(section[:text], source_document_phrases(selected_line)) %></pre>
    <% end %>
    <% document.warnings.each do |warning| %>
      <p class="empty-state__body" role="note"><%= warning %></p>
    <% end %>
    <% if document.sections.empty? && document.warnings.empty? %>
      <p class="empty-state__body">No original text was provided.</p>
    <% end %>
  </div>
</section>
