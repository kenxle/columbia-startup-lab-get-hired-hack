<section class="review__source" aria-labelledby="source-heading">
  <div class="panel panel--source">
    <div class="panel__head">
      <h2 id="source-heading" class="panel__title">Original RFQ</h2>
      <% if quote.original_filename.present? %>
        <%= link_to source_quote_path(quote), class: "file-link" do %>
          Download <span class="mono"><%= quote.original_filename %></span>
        <% end %>
      <% end %>
    </div>

    <% if selected_line.present? %>
      <p class="panel__meta">
        Highlighted: the words line <%= selected_line.position %> was read from.
      </p>
    <% end %>

    <% if quote.source_text.present? %>
      <pre class="source-text" tabindex="0" aria-label="Original RFQ text"><%= highlighted_source(quote.source_text, evidence_phrases(selected_line)) %></pre>
    <% elsif quote.original_filename.present? %>
      <div class="empty-state empty-state--inline">
        <h3 class="empty-state__title">Original file saved</h3>
        <p class="empty-state__body">No pasted text came with this RFQ. Download the file to read it. Its contents are not displayed here.</p>
      </div>
    <% else %>
      <div class="empty-state empty-state--inline">
        <p class="empty-state__body">No original text was provided.</p>
      </div>
    <% end %>

    <% if selected_line.present? %>
      <div class="source-excerpt">
        <h3 class="source-excerpt__title">Line <%= selected_line.position %> as written</h3>
        <% if selected_line.original_text.present? %>
          <blockquote class="quote-text"><%= selected_line.original_text %></blockquote>
        <% else %>
          <p class="muted"><%= unknown_marker %> No source text recorded for this line.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
