<% content_for :title, "#{@quote.reference} #{@quote.title}".strip %>

<header class="page-header page-header--quote">
  <div>
    <p class="eyebrow">
      <%= link_to "Quotes", quotes_path, class: "crumb" %>
      <span aria-hidden="true">/</span>
      <span class="mono"><%= @quote.reference %></span>
    </p>
    <h1 class="page-title">
      <%= @quote.title.presence || "Untitled RFQ" %>
    </h1>
    <p class="page-lede">
      Buyer: <strong><%= display_value(@quote.buyer_name) %></strong>
      <span class="dot" aria-hidden="true"></span>
      Received <%= display_time(@quote.created_at) %>
    </p>
  </div>
  <div class="page-actions">
    <% if @quote.held_count.positive? %>
      <%= link_to "Review buyer questions (#{@quote.held_count})", quote_buyer_questions_path(@quote),
            class: "button button--quiet review-questions-link" %>
    <% end %>
    <%= quote_status_badge(@quote) %>
  </div>
</header>

<% if @quote.sample_data? %>
  <div class="sample-banner" role="note">
    <%= sample_badge %>
    <p>This RFQ, its catalog matches and its prices are synthetic sample data for demonstration. They are not live market prices and not real stock.</p>
  </div>
<% end %>

<%= render "quotes/summary", quote: @quote, lines: @lines %>
<%= render "quotes/processing_run", quote: @quote %>
<%= render "quotes/processing_evidence", quote: @quote %>

<div class="review">
  <%= render "quotes/source_panel", quote: @quote, selected_line: @selected_line %>

  <section class="review__quote" aria-labelledby="quote-heading">
    <div class="panel">
      <div class="panel__head">
        <h2 id="quote-heading" class="panel__title">Quote lines</h2>
        <p class="panel__meta">Select a line to see its source and edit it.</p>
      </div>

      <% if @quote.awaiting_processing? %>
        <div class="empty-state empty-state--inline">
          <h3 class="empty-state__title">Awaiting processing</h3>
          <p class="empty-state__body">The original RFQ is saved. Quote lines appear here once the reading and matching results are applied. Nothing has been inferred or priced yet.</p>
        </div>
      <% else %>
        <%= render "quotes/review_navigation", quote: @quote, lines: @lines,
              selected_line: @selected_line, status: @status || "all" %>
        <%= render "quotes/lines_table", quote: @quote, lines: @visible_lines || @lines,
              selected_line: @selected_line, status: @status || "all" %>
      <% end %>
    </div>

    <% if @selected_line.present? %>
      <%= render "quotes/line_detail", quote: @quote, line: @selected_line %>
    <% end %>

    <% unless @quote.awaiting_processing? %>
      <%= render "quotes/approval", quote: @quote, lines: @lines %>
    <% end %>
  </section>
</div>
