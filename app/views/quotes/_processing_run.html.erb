<% run = ProcessingRun.where(quote_id: quote.id).order(id: :desc).first %>
<% empty_quote = quote.quote_lines.empty? %>
<% if run || empty_quote %>
  <section class="panel processing-run" aria-labelledby="processing-run-heading">
    <div class="panel__head">
      <h2 id="processing-run-heading" class="panel__title">RFQ processing</h2>
      <% if QuoteWorkspace::LiveModels.enabled? %>
        <p class="panel__meta">New processing runs may use the configured model to fill empty specification fields supported by source words. If the model is unavailable, the rules reading remains. Review each field's source explanation for accepted model readings. Catalog matching uses rules. Prices come from supported catalog sources, never the model.</p>
      <% else %>
        <p class="panel__meta">Rules-based parsing with RudCo and metals catalog matching. Prices appear only when the source and sale unit support them. No AI provider is called.</p>
      <% end %>
    </div>
    <div class="panel__body">
      <% if run %>
        <p class="processing-run__status"><strong>Status:</strong> <%= run.status.humanize %></p>
        <% if run.error_message.present? %>
          <p class="processing-run__error" role="alert"><%= run.error_message %></p>
        <% end %>
        <% if run.status == "succeeded" %>
          <p>Review the extracted specifications and questions below. Unmatched lines remain unpriced.</p>
        <% elsif run.active? %>
          <p>Processing the saved source. Refresh this page to check for results.</p>
          <%= link_to "Refresh processing status", quote_path(quote), class: "button button--quiet" %>
        <% elsif !empty_quote %>
          <p>Existing quote lines are preserved. Reprocessing reviewed lines is not available here.</p>
        <% end %>
      <% else %>
        <p>The source is saved and ready for extraction.</p>
      <% end %>
      <% if empty_quote && (run.nil? || %w[failed stale].include?(run.status)) %>
        <%= form_with url: quote_processing_path(quote), method: :post, class: "processing-run__form" do %>
          <%= hidden_field_tag :reviewed_version, quote.review_revision %>
          <%= submit_tag(run ? "Retry processing" : "Process RFQ", class: "button button--primary") %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
