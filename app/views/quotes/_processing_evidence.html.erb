<% source = quote.processing_source || {} %>
<% warnings = Array(quote.processing_warnings) %>
<% if source.present? || warnings.any? %>
  <section class="panel processing-evidence" aria-labelledby="processing-evidence-heading">
    <div class="panel__head">
      <h2 id="processing-evidence-heading" class="panel__title">Extraction evidence</h2>
      <p class="panel__meta">Internal review details. These are excluded from buyer exports.</p>
    </div>
    <div class="panel__body">
      <% if source.present? %>
        <dl>
          <dt>Source type</dt><dd><%= source["type"] %></dd>
          <% if source["filename"].present? %>
            <dt>File</dt><dd><%= source["filename"] %></dd>
          <% end %>
          <% unless source["pages"].nil? %>
            <dt>Pages</dt><dd><%= source["pages"] %></dd>
          <% end %>
          <% unless source["rows"].nil? %>
            <dt>Rows</dt><dd><%= source["rows"] %></dd>
          <% end %>
        </dl>
      <% end %>
      <% if warnings.any? %>
        <h3>Extraction warnings</h3>
        <ul>
          <% warnings.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>
<% end %>
