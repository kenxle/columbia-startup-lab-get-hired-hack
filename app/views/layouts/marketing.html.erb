<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Every line shows its work." %> · RudCo Quote Desk</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="RudCo Quote Desk">
    <meta name="description" content="Read messy industrial RFQs, review the source of each line, and prepare a quote with RudCo Quote Desk.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "rudco-favicon.png", type: "image/png" %>
    <%= stylesheet_link_tag "application", "marketing" %>
  </head>
  <body class="marketing-shell">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="marketing-header">
      <div class="marketing-container">
        <%= link_to product_path, class: "marketing-brand", aria: { label: "RudCo Quote Desk product" } do %>
          <%= image_tag "/brand/rudco-mark.png", alt: "", width: 32, height: 32 %>
          <span class="brand__identity">
            <span class="marketing-brand-name">RudCo</span>
            <span class="marketing-brand-product">QUOTE DESK</span>
          </span>
        <% end %>
        <nav class="marketing-nav" aria-label="Product">
          <%= link_to "Product", product_path, aria: { current: action_name == "product" ? "page" : nil } %>
          <%= link_to "Compare", comparison_path, aria: { current: action_name == "comparison" ? "page" : nil } %>
          <%= link_to "Open Quote Desk", quotes_path, class: "button button--primary" %>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><%= yield %></main>
    <footer class="marketing-footer">
      <div class="marketing-container">
        <p>RudCo Quote Desk. Every line shows its work.</p>
        <nav aria-label="Footer">
          <%= link_to "Product", product_path %>
          <%= link_to "Compare", comparison_path %>
          <%= link_to "Open Quote Desk", quotes_path %>
        </nav>
      </div>
    </footer>
  </body>
</html>
