<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= workspace_document_title(page_title: content_for(:title), quote: @quote) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RudCo Quote Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag "rudco-favicon.png", type: "image/png" %>
    <%= favicon_link_tag "rudco-favicon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag :app %>
    <%= render "layouts/lahe" %>
    <%= javascript_include_tag "quote_deadlines", defer: true %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <%= render "layouts/sidebar" %>
      <main id="main" class="workspace" tabindex="-1">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
