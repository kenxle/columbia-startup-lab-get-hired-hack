<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · RudCo Quote Desk" : "RudCo Quote Desk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RudCo Quote Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag "rudco-favicon.png", type: "image/png" %>
    <%= favicon_link_tag "rudco-favicon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag :app %>
    <%= render "layouts/lahe" %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="brand-header">
      <%= link_to root_path, class: "brand-header__lockup", aria: { label: "RudCo Quote Desk home" } do %>
        <%= image_tag "rudco-mark.png", alt: "RudCo Industrial Materials Platform logo", width: 32, height: 32, class: "brand-header__mark" %>
        <span class="brand-header__identity">
          <span class="brand-header__name">RudCo</span>
          <span class="brand-header__tagline">Industrial Materials Platform</span>
        </span>
      <% end %>
      <nav class="brand-header__nav" aria-label="Product">
        <%= link_to "Quote Desk", quotes_path, class: "brand-header__product" %>
      </nav>
    </header>
    <div class="shell">
      <%= render "layouts/sidebar" %>
      <main id="main" class="workspace" tabindex="-1">
        <%= render "layouts/flash" %>
        <%= yield %>
        <footer class="workspace-footer">Concept built for RudCo · Get Hired Hack, 2026-10-10</footer>
      </main>
    </div>
  </body>
</html>
