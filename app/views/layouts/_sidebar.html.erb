<aside class="sidebar" aria-label="Primary">
  <%= link_to quotes_path, class: "sidebar__brand", aria: { label: "RudCo Quote Desk home" } do %>
    <%= image_tag "/brand/rudco-mark.png", alt: "", width: 32, height: 32, class: "brand__mark" %>
    <span class="brand__identity">
      <span class="sidebar__name">RudCo</span>
      <span class="sidebar__product">QUOTE DESK</span>
    </span>
  <% end %>

  <nav class="sidebar__nav" aria-label="Workspace">
    <%= link_to "Quotes", quotes_path,
          class: ["sidebar__link", ("is-active" if current_page?(quotes_path) || current_page?(root_path))],
          aria: { current: (current_page?(quotes_path) || current_page?(root_path)) ? "page" : nil } %>
    <%= link_to "New RFQ", new_quote_path,
          class: ["sidebar__link", ("is-active" if current_page?(new_quote_path))],
          aria: { current: current_page?(new_quote_path) ? "page" : nil } %>
    <%= link_to "Find catalog item", catalog_matches_path,
          class: ["sidebar__link", ("is-active" if controller_name == "catalog_matches")],
          aria: { current: controller_name == "catalog_matches" ? "page" : nil } %>
  </nav>

  <div class="sidebar__footer">
    <%= button_to "Load demo RFQ", demo_quotes_path, method: :post, class: "sidebar__sample", form_class: "sidebar__sample-form" %>
  </div>
</aside>
