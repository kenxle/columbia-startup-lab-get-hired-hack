#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs Ken's 25-line test set (spec/fixtures/test_set.yml) through the rules parser,
# the readiness rule and the compliance flags, and prints a Markdown report to stdout.
# Deterministic, offline. The committed output is docs/rfq_processing/TEST-RESULTS.md.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "rfq_processing"
require "yaml"

COMMAND = 'cd tools/rfq_processing && SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk ' \
          'BUNDLE_GEMFILE="$PWD/Gemfile" ../../script/with-ruby bundle _2.4.19_ exec ruby bin/test-set-report ' \
          "> ../../docs/rfq_processing/TEST-RESULTS.md"
FIXTURE = File.expand_path("../spec/fixtures/test_set.yml", __dir__)
GAUGE_TRAP = %w[T1 T10 T11 T12 T13 T14 T25].freeze
COMPARED = %w[material grade form thickness wall width length].freeze

def cell(text, limit = nil)
  s = text.to_s.gsub("|", "\\|").gsub(/\s+/, " ").strip
  limit && s.size > limit ? "#{s[0, limit].rstrip}..." : s
end

def norm(value) = value.to_s.downcase.gsub(/\bgrade\b/, "gr").gsub(%r{[^a-z0-9/]+}, " ").strip

def same?(expected, actual)
  return false if actual.nil?
  return norm(expected) == norm(actual) unless expected.is_a?(Numeric) && actual.is_a?(Numeric)

  (expected - actual).abs <= 0.005 * expected.abs
end

def expected_values(e)
  { "material" => e["material"], "grade" => e["grade"], "form" => e["form"], "thickness" => e["thickness_in"],
    "wall" => e["wall_in"], "width" => e["width_in"], "length" => e["length_in"] }
end

def parser_values(f)
  { "material" => f["material"], "grade" => f["grade"], "form" => f["form"], "thickness" => f["thickness_in"],
    "wall" => f["wall_in"], "width" => f["width_in"] || f["side_a_in"], "length" => f["length_in"] }
end

def read_summary(f)
  size = if f["side_a_in"] then [f["side_a_in"], f["side_b_in"], f["length_in"]].compact.join(" x ")
         elsif f["diameter_in"] then "dia #{f['diameter_in']} x #{f['length_in']}"
         elsif f["nominal_size_in"] then "NPS #{f['nominal_size_in']} x #{f['length_in']}"
         else [f["width_in"], f["length_in"]].compact.join(" x ")
         end
  thick = f["thickness_in"] ? "#{f['thickness_in']} in thick" : (f["wall_in"] && "#{f['wall_in']} in wall")
  [f["material"] || "material not read", f["grade"], f["form"], thick, (size unless size.empty?),
   (f["quantity"] && "qty #{f['quantity']}")].compact.join(", ")
end

def state_label(reading, decision)
  return "Ready" unless decision.state == "needs_buyer"

  blank = reading.unknowns.map { |u| u["field"] } & %w[material thickness_in wall_in]
  blank.any? || reading.conflicts.any? { |c| c["code"] == "shape_vs_spec" } ? "Cannot read" : "Needs the buyer"
end

def thickness_story(r)
  ev = r.evidence["thickness_in"] || r.evidence["wall_in"]
  ev ? ev["explanation"] : (r.unknowns.find { |u| u["field"] == "thickness_in" } || {})["reason"].to_s
end

def rule_used(r) = r.rules_used.first || (thickness_story(r).empty? ? "(no table or rule needed)" : thickness_story(r))

entries = YAML.safe_load(File.read(FIXTURE), aliases: true)["lines"]
rows = entries.map do |e|
  n = e["id"].delete("T").to_i
  reading = RfqProcessing::RulesParser.parse(e["text"], position: n)
  decision = RfqProcessing::Readiness.decide(reading, match: nil, position: n)
  flags = RfqProcessing::Compliance.flags(text: e["text"], spec: reading.fields.compact,
                                          context: (e["context"] || {}).transform_keys(&:to_sym))
  exp = expected_values(e["expected"])
  got = parser_values(reading.fields)
  differs = COMPARED.select { |k| !exp[k].nil? && !same?(exp[k], got[k]) }
  { e: e, reading: reading, decision: decision, flags: flags, got: got, exp: exp, differs: differs,
    held: decision.state == "needs_buyer", research_held: e["state_hint"] != "ready",
    match: differs.empty? ? "Yes" : "Differs: #{differs.join(', ')}" }
end

matched = rows.count { |r| r[:match] == "Yes" }
held = rows.select { |r| r[:held] }
held_expected = rows.select { |r| r[:held] && r[:research_held] }
held_for_qty = rows.select { |r| r[:held] && !r[:research_held] }
not_held = rows.select { |r| !r[:held] && r[:research_held] }
flag_count = rows.sum { |r| r[:flags].size }
ids = ->(list) { list.map { |r| r[:e]["id"] }.join(", ") }

puts "# RFQ processing: results on the 25-line test set"
puts
puts "Generated by `#{COMMAND}` on #{Time.now.strftime('%Y-%m-%d %H:%M %Z')}. Do not edit by hand; rerun the command."
puts
puts "The test set is the 25 RFQ lines in Ken's domain research, section 6 (docs/research/20261010.01_rfq_sharper_angle/research_domain_rules.md), transcribed into tools/rfq_processing/spec/fixtures/test_set.yml. Lines marked V are verbatim from public RFQs (Iowa, SacRT, a UAlberta catalog listing). Lines marked C were constructed by the researcher from cited rules. Right means the reading the research gives for the line: material, grade, form, thickness or wall, width and length. A parser value counts as right when it agrees with the research value, numbers within 0.5% count as equal, the words Gr and Grade count as the same, and a field the research leaves null is skipped. Quantity is not compared; the research took most quantities from the RFQ header, which the line does not carry. State comes from the readiness rule with no catalog match: Ready means the parser needed nothing from the buyer, Needs the buyer means the rule held the line with a question, and Cannot read means the rule held the line and the parser left the material or the thickness blank, or the shape and the spec contradict each other. Line N inside a question is the test-set number."
puts
puts "**Summary:** #{matched} of 25 lines read as the research expects. #{held.size} of 25 lines are held with a question. " \
     "The research holds #{rows.count { |r| r[:research_held] }} lines; #{held_expected.size} of those are held here (#{ids.call(held_expected)}). " \
     "#{not_held.size} are held by the research for a compliance or quantity-unit question and are not held by the parser (#{ids.call(not_held)}); their requirements appear below as flags. " \
     "#{held_for_qty.size} lines the research calls ready are held here only for the quantity (#{ids.call(held_for_qty)}). " \
     "#{flag_count} compliance flags found on #{rows.count { |r| r[:flags].any? }} lines."
puts
puts "| ID | Line | What the parser read | State | Rule or table used | Flags | Matches research? |"
puts "|---|---|---|---|---|---|---|"
rows.each do |r|
  e = r[:e]
  puts "| #{e['id']} (#{e['kind'] == 'verbatim' ? 'V' : 'C'}) | #{cell(e['text'], 60)} | #{cell(read_summary(r[:reading].fields))} " \
       "| #{state_label(r[:reading], r[:decision])} | #{cell(rule_used(r[:reading]), 80)} | #{cell(r[:flags].map { |f| f['label'] }.join('; '))} | #{cell(r[:match])} |"
end
puts
puts "## The gauge trap, shown"
puts
puts "A gauge number is not a thickness. The parser looks it up in a table chosen by material and form, and says which table it used. The text below is the exact explanation the parser attaches to the thickness, or the reason it left the thickness blank."
puts
rows.select { |r| GAUGE_TRAP.include?(r[:e]["id"]) }.each do |r|
  puts "- **#{r[:e]['id']}** (`#{r[:e]['text']}`): #{thickness_story(r[:reading])}"
end
puts
puts "## Questions the parser asks"
puts
puts "One question per held line, exactly as the readiness rule words it. The research question is shown after it for comparison."
puts
held.each do |r|
  puts "- **#{r[:e]['id']}**: #{r[:decision].question}"
  puts "  - Research asks: #{r[:e]['ask'] || '(none)'}"
end
puts
puts "## Known gaps"
puts
differing = rows.reject { |r| r[:match] == "Yes" }
puts "Lines where Matches research? is not Yes#{differing.empty? ? ': none.' : ':'}"
differing.each do |r|
  r[:differs].each do |k|
    puts "- **#{r[:e]['id']}**, #{k}: the research says #{r[:exp][k].inspect}, the parser read #{r[:got][k].nil? ? 'nothing' : r[:got][k].inspect}. Parser fields: #{cell(read_summary(r[:reading].fields))}."
  end
end
puts
puts "Fields the comparison skips on purpose:"
header_qty = rows.select { |r| r[:e]["expected"]["quantity"] && r[:reading].fields["quantity"].nil? }
puts "- Quantity. The research took the quantity from the RFQ header for #{ids.call(header_qty)}; the line alone does not carry it, so the parser holds each of them for the quantity."
qty_extra = rows.select { |r| r[:e]["expected"]["quantity"].nil? && r[:reading].fields["quantity"] }
puts "- Quantity the parser read where the research left it open: #{qty_extra.map { |r| "#{r[:e]['id']} (parser qty #{r[:reading].fields['quantity']}, research: #{r[:e]['ask']})" }.join('; ')}." if qty_extra.any?
inferred = rows.select { |r| r[:reading].evidence.dig("form", "explanation").to_s.include?("no form word") }
puts "- Form inferred by rule, not read from a word on the line: #{inferred.map { |r| "#{r[:e]['id']} (#{r[:reading].fields['form']}: #{r[:reading].evidence['form']['explanation']})" }.join('; ')}. The research inferred the same forms, so these count as matches, but they rest on a convention."
puts "- Standard, finish, coating, temper, diameter and schedule are not compared. The parser folds a grade letter into the standard on tube (T25 reads standard A500 Grade C and no grade), and reads A516-70 as standard A516 with grade A516-70 (T23)."
puts "- Compliance questions (certs, DFARS, Buy America, ITAR, PMI, NACE) are flags, not parser questions, so #{ids.call(not_held)} are Ready here although the research holds them for those questions."
