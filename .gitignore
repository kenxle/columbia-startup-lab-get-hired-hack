# Agent identity and scratch files (per machine, never committed)
.agent-owner
.claude-commit*
.codex-commit*
.claude/settings.local.json
.serena/
.bundle/
/config/master.key
/config/credentials/*.key
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets

# Secrets (this repo is public)
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.idea/
.vscode/
.obsidian/

# Dependencies and builds
node_modules/
__pycache__/
.venv/
dist/
build/

# Local supplier page snapshots, retained for audit but not republished
data/aviation/raw/
.local-tools/
